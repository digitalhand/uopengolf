# Unreal / IDE output (including future public plugins)
Binaries/
Packaged
# Cook/editor file-open order logs written by packaging.
/Build/*/FileOpenOrder/
DerivedDataCache/
Intermediate/
Saved/
.vs/
.idea/
.vscode/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.code-workspace
# Generated by UnrealBuildTool's VS Code project files (ripgrep search excludes)
/.ignore
*.xcworkspace/
*.xcodeproj/
*.slnx

# Agents
AGENTS.md
CLAUDE.md
CLAUDE.local.md
.claude
*.superpowers
.mcp.*


# Agent Docs
/Docs/superpowers/*

# Per-machine config layer.
/Config/User*.ini

# The editor's per-user content folders, named after the OS account.
/Content/Developers/
/Plugins/*/Content/Developers/

# Blender projects live outside the repository under the Blender art root
# (Plugins/OpenGolfCourse/Scripts/art_root.py); only Unreal-ready assets are committed.
*.blend
*.blend1

# Local tools and OS state
__pycache__/
*.pyc
.env
.env.*
.DS_Store
Thumbs.db

# Third-party reference data (launch-monitor exports, published averages, calculator output, accuracy
# baselines) and research papers stay outside the repository, in UOPENGOLF_DATA (default ~/data/uopengolf);
# see Assets/Data/README.md. Only uopengolf's own shot recordings are committed.
/Assets/Data/ShotLibrary/*
!/Assets/Data/ShotLibrary/recorded_*/
/Assets/Data/ShotLibraryBaselines/
/Docs/papers/

# .NET reference harness output
/Plugins/OpenFairwayPhysics/Tools/ReferenceHarness/bin/
/Plugins/OpenFairwayPhysics/Tools/ReferenceHarness/obj/
