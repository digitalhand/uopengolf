# Unreal / IDE output (including future public plugins)
Binaries/
Packaged
# Cook/editor file-open order logs written by packaging.
/Build/*/FileOpenOrder/
DerivedDataCache/
Intermediate/
Saved/
.vs/
.idea/
.vscode/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.code-workspace
# Generated by UnrealBuildTool's VS Code project files (ripgrep search excludes)
/.ignore
*.xcworkspace/
*.xcodeproj/
*.slnx

# Agents
AGENTS.md
CLAUDE.md
CLAUDE.local.md
.claude

# Agent Docs
/Docs/superpowers/*

# Restricted assets must live outside public history, including Git LFS.
/Plugins/PrivateContent/
# Fab's default import destination for the optional Project Nature pack.
/Content/PN_GrassLibrary/
# Fab's default import destinations for the optional DZ Sample Trees and
# MW Landscape Auto Material packs. Installed copies live in Plugins/PrivateContent/.
/Content/DZ_Assets/
/Content/MWLandscapeAutoMaterial/
# Per-machine config layer, e.g. LocalRangeClass for an installed private range.
/Config/User*.ini

# Blender projects live outside the repository under the Blender art root
# (Plugins/OpenGolfCourse/Scripts/art_root.py); only Unreal-ready assets are committed.
*.blend
*.blend1

# Local tools and OS state
__pycache__/
*.pyc
.env
.env.*
.DS_Store
Thumbs.db

# .NET reference harness output
/Plugins/OpenFairwayPhysics/Tools/ReferenceHarness/bin/
/Plugins/OpenFairwayPhysics/Tools/ReferenceHarness/obj/
