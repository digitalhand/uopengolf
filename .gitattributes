* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.cs text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.uproject text eol=lf
*.blend binary
# Unreal assets are stored in Git LFS (migrated 2026-10-27); -text also marks them binary.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
