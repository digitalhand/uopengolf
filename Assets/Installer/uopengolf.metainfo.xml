<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC0-1.0 -->
<!-- AppStream metadata that software centres show for the installed game. build_deb.py fills in the
     release placeholders and installs it as /usr/share/metainfo/io.github.digitalhand.uopengolf.metainfo.xml. -->
<component type="desktop-application">
  <id>io.github.digitalhand.uopengolf</id>
  <metadata_license>CC0-1.0</metadata_license>
  <!-- The project's code is MIT. The package also contains Unreal Engine runtime binaries under Epic's EULA. -->
  <project_license>MIT AND LicenseRef-proprietary=https://www.unrealengine.com/en-US/eula/standard</project_license>
  <name>UOpenGolf</name>
  <summary>Golf simulation with launch monitor support</summary>
  <developer id="io.github.digitalhand">
    <name>UOpenGolf contributors</name>
  </developer>
  <description>
    <p>
      An open-source golf simulation game built with Unreal Engine. Physics, Freedom, Golf!
    </p>
    <p>Hit shots with:</p>
    <ul>
      <li>Replay shots</li>
      <li>A Square Home launch monitor</li>
      <li>An Open Connect connector</li>
    </ul>
    <p>Requires a graphics device with Vulkan support.</p>
  </description>
  <!-- A downloaded .deb has no distribution catalog entry to name its package, and KDE Discover skips
       components without one. Keep this equal to Package: in build_deb.py. -->
  <pkgname>uopengolf</pkgname>
  <launchable type="desktop-id">uopengolf.desktop</launchable>
  <icon type="stock">uopengolf</icon>
  <!-- Same as uopengolf.desktop. -->
  <categories>
    <category>Game</category>
    <category>SportsGame</category>
  </categories>
  <url type="homepage">https://github.com/digitalhand/uopengolf</url>
  <url type="bugtracker">https://github.com/digitalhand/uopengolf/issues</url>
  <url type="vcs-browser">https://github.com/digitalhand/uopengolf</url>
  <screenshots>
    <screenshot type="default">
      <caption>The savanna driving range</caption>
      <image>https://raw.githubusercontent.com/digitalhand/uopengolf/main/Assets/Images/public_range.png</image>
    </screenshot>
    <screenshot>
      <caption>Shot data from a launch monitor</caption>
      <image>https://raw.githubusercontent.com/digitalhand/uopengolf/main/Assets/Images/linux_square_shot.png</image>
    </screenshot>
  </screenshots>
  <!-- The game checks GitHub for updates and offers an optional online account. -->
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <provides>
    <binary>uopengolf</binary>
  </provides>
  <releases>
    <release version="@VERSION@" date="@DATE@" type="@TYPE@"/>
  </releases>
</component>
